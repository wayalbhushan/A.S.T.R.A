# Flask config
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=dev-secret-key-change-in-prod

# Database config (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@db:5432/astra

# Redis config (separated by db index as requested)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_REDIS_URL=redis://redis:6379/2
RATELIMIT_STORAGE_URI=redis://redis:6379/3

# File upload config (150MB max)
UPLOAD_FOLDER=/app/uploads
MAX_UPLOAD_MB=150

# VirusTotal API config
# VirusTotal's free key is not licensed for commercial use, so each deployment must bring its own key.
VT_API_KEY=your_virustotal_api_key_here
VT_ENABLED=true
# VT_ALLOW_UPLOAD=false means samples are never uploaded and only hashes are looked up.
# VT_CACHE_TTL_OK: cache TTL in seconds for positive lookups (default 86400, 24 hours).
VT_CACHE_TTL_OK=86400

# VirusTotal evidence floor settings (heuristics to tune)
VT_FLOOR_MALICIOUS_ENGINES=10
VT_FLOOR_CATEGORY_ENGINES=5
VT_FLOOR_SUSPICIOUS_ENGINES=3
VT_FLOOR_MALICIOUS=85
VT_FLOOR_SUSPICIOUS=45
